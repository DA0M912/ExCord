<Window x:Class="ExCord.Views.GifTalkOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="InvisibleResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid" Background="Transparent" Opacity="1" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <wv2:WebView2 x:Name="WebView"
                      DefaultBackgroundColor="Transparent" />

        <Rectangle x:Name="EditModeCard"
                   Stroke="#3AA0FF"
                   StrokeThickness="1.5"
                   RadiusX="8" RadiusY="8"
                   Fill="#4D1F2328"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"
                   SnapsToDevicePixels="True"/>

        <Border x:Name="DragArea"
                Background="Transparent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Cursor="SizeAll"
                PreviewMouseLeftButtonDown="DragArea_MouseLeftButtonDown"
                MouseLeftButtonDown="DragArea_MouseLeftButtonDown"
                MouseMove="DragArea_MouseMove"
                PreviewMouseLeftButtonUp="DragArea_MouseLeftButtonUp"
                Visibility="Collapsed" />

        <Grid x:Name="EditModeActionButtons"
              Width="90"
              Height="36"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="0,0,12,12"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="ConfirmEditButton"
                    Grid.Column="0"
                    Height="32"
                    Click="ConfirmEditButton_Click"
                    ToolTip="Check"
                    Background="#2F7D32"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="Bold"
                    Content="✓" />

            <Button x:Name="CancelEditButton"
                    Grid.Column="2"
                    Height="32"
                    Click="CancelEditButton_Click"
                    ToolTip="Close"
                    Background="#A63C3C"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="Bold"
                    Content="✕" />
        </Grid>
    </Grid>
</Window>
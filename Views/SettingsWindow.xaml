<Window x:Class="ExCord.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="440"
        Height="820"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#20232A">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Foreground" Value="#AAB0BC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="#20232A"
                                BorderBrush="#3A3F4B"
                                BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2B2F36"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid ClipToBounds="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0"
                                       IsItemsHost="True"
                                       Background="Transparent"
                                       LastChildFill="False"/>
                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter ContentSource="SelectedContent" Margin="12"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayExpanderStyle" TargetType="Expander">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#3A3F4B"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="8,2,12,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" ContentSource="Header" VerticalAlignment="Center"/>
                                    <ToggleButton Grid.Column="1"
                                                  Width="32"
                                                  Height="32"
                                                  Margin="10,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Foreground="White"
                                                  Padding="0">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Width="40" Height="32" VerticalAlignment="Center">
                                                    <Path x:Name="Arrow"
                                                          Width="22"
                                                          Height="14"
                                                          Fill="White"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="M 0 0 L 14 0 L 7 10 Z"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Arrow" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="180" CenterX="7" CenterY="5"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                                <Border x:Name="ContentBorder"
                                        Grid.Row="1"
                                        Padding="10,0,10,10"
                                        Visibility="Collapsed">
                                    <ContentPresenter ContentSource="Content"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ContentBorder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayEnabledSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#4E5058"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Background="{TemplateBinding Background}" CornerRadius="11">
                            <Ellipse x:Name="Thumb"
                                     Width="16"
                                     Height="16"
                                     Margin="3"
                                     HorizontalAlignment="Left"
                                     Fill="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#5865F2"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayListScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#E8ECF3"
                                                        CornerRadius="1"
                                                        Width="2"
                                                        HorizontalAlignment="Right"
                                                        SnapsToDevicePixels="True"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#2B2F36"/>
            <Setter Property="BorderBrush" Value="#3A3F4B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="4">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayDeleteMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3F4B"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5865F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="18">
            <TabControl x:Name="MainTabControl" Background="#20232A" BorderBrush="#3A3F4B" BorderThickness="1">
                <TabItem x:Name="WebViewTabItem" Header="" Background="#20232A" Foreground="White">
                    <Grid Margin="0,12,0,0">
                        <Border x:Name="WebViewContentPanel"
                                Margin="0"
                                Padding="0"
                                Background="Transparent"
                                SnapsToDevicePixels="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect ShadowDepth="0" BlurRadius="0" Opacity="0" Color="Black"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=WebViewToggleButton}" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                            <Setter Property="Background" Value="#121212"/>
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect ShadowDepth="0" BlurRadius="2" Opacity="0.45" Color="Black"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" ClipToBounds="False">
                                    <ScrollViewer x:Name="OverlayScrollViewer"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Padding="0"
                                                  Margin="0"
                                                  Loaded="OverlayScrollViewer_Loaded"
                                                  ScrollChanged="OverlayScrollViewer_ScrollChanged">
                                        <ItemsControl x:Name="OverlayItemsControl"
                                                      HorizontalAlignment="Stretch">
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Expander Margin="0,0,0,10"
                                                          Style="{StaticResource OverlayExpanderStyle}"
                                                          Expanded="OverlayExpander_Expanded"
                                                          Collapsed="OverlayExpander_Collapsed"
                                                          Tag="{Binding Id}"
                                                          Background="#2B2F36"
                                                          Foreground="White">
                                                    <Expander.ContextMenu>
                                                        <ContextMenu Style="{StaticResource OverlayContextMenuStyle}">
                                                            <MenuItem Header="삭제"
                                                                      Style="{StaticResource OverlayDeleteMenuItemStyle}"
                                                                      Click="OverlayContextDelete_Click"/>
                                                        </ContextMenu>
                                                    </Expander.ContextMenu>
                                                    <Expander.Header>
                                                        <Grid Margin="0,2,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0"
                                                                    Width="28"
                                                                    Height="28"
                                                                    Margin="0,0,10,0"
                                                                    Background="Transparent"
                                                                    Cursor="SizeNS"
                                                                    Tag="{Binding Id}"
                                                                    PreviewMouseLeftButtonDown="OverlayDragHandle_PreviewMouseLeftButtonDown"
                                                                    PreviewMouseMove="OverlayDragHandle_PreviewMouseMove"
                                                                    PreviewMouseLeftButtonUp="OverlayDragHandle_PreviewMouseLeftButtonUp">
                                                                <TextBlock Text="☰"
                                                                           FontSize="18"
                                                                           Foreground="#D7DDE5"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>

                                                            <Grid Grid.Column="1" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Name}"
                                                                           Tag="OverlayNameDisplay"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="White"
                                                                           Margin="0,0,26,0"/>
                                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                         Tag="OverlayNameEditor"
                                                                         Visibility="Collapsed"
                                                                         Background="#20232A"
                                                                         Foreground="White"
                                                                         BorderBrush="#5865F2"
                                                                         BorderThickness="1"
                                                                         Padding="6,3"
                                                                         VerticalContentAlignment="Center"
                                                                         TextChanged="OverlayNameTextBox_TextChanged"
                                                                         KeyDown="OverlayNameEditor_KeyDown"/>
                                                            </Grid>

                                                            <ToggleButton Grid.Column="2"
                                                                          Style="{StaticResource OverlayEnabledSwitchStyle}"
                                                                          ToolTip="On/Off"
                                                                          Margin="8,0,0,0"
                                                                          IsChecked="{Binding Enabled}"
                                                                          Checked="OverlayEnabledToggleButton_Checked"
                                                                          Unchecked="OverlayEnabledToggleButton_Unchecked"/>
                                                        </Grid>
                                                    </Expander.Header>

                                                    <StackPanel Margin="0,10,0,4">
                                                        <TextBlock x:Name="WebUrlTextBlock"
                                                                   Text=""
                                                                   Loaded="OverlayLocalizedElement_Loaded"
                                                                   FontWeight="Bold"
                                                                   Margin="0,0,0,8"
                                                                   Foreground="White"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                            <TextBox Width="260"
                                                                     Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="#20232A"
                                                                     Foreground="White"
                                                                     BorderBrush="#3A3F4B"
                                                                     Tag="{Binding Id}"/>
                                                            <Button Content=""
                                                                    Loaded="OverlayLocalizedElement_Loaded"
                                                                    Width="70"
                                                                    Margin="8,0,0,0"
                                                                    Click="ApplyOverlayUrlButton_Click"
                                                                    Tag="{Binding Id}"
                                                                    Background="#3A3F4B"
                                                                    Foreground="White"/>
                                                        </StackPanel>

                                                        <ToggleButton Content=""
                                                                      Loaded="OverlayLocalizedElement_Loaded"
                                                                      Width="120"
                                                                      HorizontalAlignment="Left"
                                                                      Margin="0,0,0,16"
                                                                      Checked="OverlayEditModeToggleButton_Checked"
                                                                      Unchecked="OverlayEditModeToggleButton_Unchecked"
                                                                      Tag="{Binding Id}"
                                                                      Foreground="White"/>

                                                        <Grid Margin="0,0,0,16">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="WebViewXTextBlock" Text="" Loaded="OverlayLocalizedElement_Loaded" Margin="0,0,8,8" VerticalAlignment="Center" Foreground="White"/>
                                                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,12,8" Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" TextChanged="OverlayGeometryTextBox_TextChanged" Background="#20232A" Foreground="White" BorderBrush="#3A3F4B" Tag="X"/>
                                                            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="WebViewYTextBlock" Text="" Loaded="OverlayLocalizedElement_Loaded" Margin="0,0,8,8" VerticalAlignment="Center" Foreground="White"/>
                                                            <TextBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,8" Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" TextChanged="OverlayGeometryTextBox_TextChanged" Background="#20232A" Foreground="White" BorderBrush="#3A3F4B" Tag="Y"/>

                                                            <TextBlock Grid.Row="1" Grid.Column="0" x:Name="WebViewWidthTextBlock" Text="" Loaded="OverlayLocalizedElement_Loaded" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White"/>
                                                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,0" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" TextChanged="OverlayGeometryTextBox_TextChanged" Background="#20232A" Foreground="White" BorderBrush="#3A3F4B" Tag="Width"/>
                                                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="WebViewHeightTextBlock" Text="" Loaded="OverlayLocalizedElement_Loaded" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White"/>
                                                            <TextBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,0" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" TextChanged="OverlayGeometryTextBox_TextChanged" Background="#20232A" Foreground="White" BorderBrush="#3A3F4B" Tag="Height"/>
                                                        </Grid>

                                                        <StackPanel>
                                                            <ToggleButton x:Name="TransparencyToggleButton"
                                                                          Content=""
                                                                          Loaded="OverlayLocalizedElement_Loaded"
                                                                          Margin="0,0,0,8"
                                                                          HorizontalAlignment="Left"
                                                                          IsChecked="{Binding TransparencyEnabled}"
                                                                          Checked="OverlayTransparencyToggleButton_Checked"
                                                                          Unchecked="OverlayTransparencyToggleButton_Unchecked"/>
                                                            <ToggleButton x:Name="InteractionToggleButton"
                                                                          Content=""
                                                                          Loaded="OverlayLocalizedElement_Loaded"
                                                                          Margin="0,0,0,8"
                                                                          HorizontalAlignment="Left"
                                                                          IsChecked="{Binding InteractionEnabled}"
                                                                          Checked="OverlayInteractionToggleButton_Checked"
                                                                          Unchecked="OverlayInteractionToggleButton_Unchecked"/>
                                                            <ToggleButton x:Name="ShiftRightClickEditToggleButton"
                                                                          Content=""
                                                                          Loaded="OverlayLocalizedElement_Loaded"
                                                                          HorizontalAlignment="Left"
                                                                          IsChecked="{Binding ShiftRightClickEditEnabled}"
                                                                          Checked="OverlayShiftRightClickEditToggleButton_Checked"
                                                                          Unchecked="OverlayShiftRightClickEditToggleButton_Unchecked"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <ScrollBar x:Name="OverlayScrollBar"
                                                   Style="{StaticResource OverlayListScrollBarStyle}"
                                                   Orientation="Vertical"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Stretch"
                                                   Margin="0,0,-10,0"
                                                   Panel.ZIndex="5"
                                                   Visibility="Collapsed"
                                                   ValueChanged="OverlayScrollBar_ValueChanged"/>
                                    </Grid>

                                    <Button x:Name="AddOverlayButton"
                                        Grid.Row="1"
                                        Content="+ 새 뷰어 추가"
                                        Margin="0,12,0,0"
                                        Height="34"
                                        Click="AddOverlayButton_Click"
                                        Background="#3A3F4B"
                                        Foreground="White"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="TtsTabItem" Header="" Background="#20232A" Foreground="White">
                    <Border x:Name="TtsContentPanel"
                            Margin="0,12,0,0"
                            Padding="0"
                            Background="Transparent"
                            SnapsToDevicePixels="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="0" Opacity="0" Color="Black"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=TtsToggleButton}" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                        <Setter Property="Background" Value="#121212"/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect ShadowDepth="0" BlurRadius="2" Opacity="0.45" Color="Black"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid TextElement.Foreground="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="GlobalHotkeyTextBlock" Grid.Row="0" Text="" FontWeight="Bold" Margin="0,0,0,8" Foreground="White"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                                <CheckBox x:Name="CtrlCheckBox" Content="Ctrl" Margin="0,0,8,0" Foreground="White"/>
                                <CheckBox x:Name="AltCheckBox" Content="Alt" Margin="0,0,8,0" Foreground="White"/>
                                <CheckBox x:Name="ShiftCheckBox" Content="Shift" Margin="0,0,8,0" Foreground="White"/>
                                <ComboBox x:Name="KeyComboBox" Width="120" Background="#2B2F36" Foreground="White" Cursor="Hand">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Foreground" Value="White"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </StackPanel>

                            <TextBlock x:Name="TtsVoiceTextBlock" Grid.Row="2" Text="" FontWeight="Bold" Margin="0,0,0,8" Foreground="White"/>
                            <ComboBox x:Name="VoiceComboBox" Grid.Row="3" Margin="0,0,0,16" DisplayMemberPath="DisplayName" Background="#2B2F36" Foreground="White" Cursor="Hand">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>

                            <TextBlock x:Name="VirtualOutputDeviceTextBlock" Grid.Row="4" Text="" FontWeight="Bold" Margin="0,0,0,8" Foreground="White"/>
                            <ComboBox x:Name="DeviceComboBox" Grid.Row="5" Margin="0,0,0,16" Background="#2B2F36" Foreground="White" Cursor="Hand">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>

                            <TextBlock x:Name="OutputVolumeTextBlock" Grid.Row="6" Text="" FontWeight="Bold" Margin="0,0,0,8" Foreground="White"/>
                            <StackPanel Grid.Row="7" Margin="0,0,0,16">
                                <Slider x:Name="OutputVolumeSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"/>
                                <TextBlock x:Name="OutputVolumeLabel" Text="100%" Margin="0,4,0,0" Foreground="White"/>
                            </StackPanel>

                            <StackPanel Grid.Row="8" Margin="0,0,0,12">
                                <CheckBox x:Name="MonitorEnabledCheckBox" Content="" Margin="0,0,0,8" Foreground="White"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem x:Name="GeneralTabItem" Header="&#x2699;" Background="#20232A" Foreground="White" DockPanel.Dock="Right">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock x:Name="ApplicationSectionTextBlock" Text="" FontWeight="Bold" Margin="0,0,0,8" Foreground="White"/>
                        <ToggleButton x:Name="AutoStartToggleButton"
                                      Content=""
                                      HorizontalAlignment="Left"
                                      Margin="0,0,0,20"/>
                        <TextBlock x:Name="FeaturesSectionTextBlock" Text="" FontWeight="Bold" Margin="0,0,0,8" Foreground="White"/>
                        <ToggleButton x:Name="TtsToggleButton"
                                      Content=""
                                      HorizontalAlignment="Left"
                                      Margin="0,0,0,10"
                                      Checked="TtsToggleButton_Checked"
                                      Unchecked="TtsToggleButton_Unchecked"/>
                        <ToggleButton x:Name="WebViewToggleButton"
                                      Content=""
                                      HorizontalAlignment="Left"
                                      Margin="0,0,0,20"
                                      Checked="WebViewToggleButton_Checked"
                                      Unchecked="WebViewToggleButton_Unchecked"/>
                        <TextBlock x:Name="LanguageSectionTextBlock"
                                   Text=""
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"
                                   Foreground="White"/>
                        <ComboBox x:Name="LanguageComboBox"
                                  Width="180"
                                  HorizontalAlignment="Left"
                                  Background="#2B2F36"
                                  Foreground="White"
                                  Cursor="Hand"
                                  SelectionChanged="LanguageComboBox_SelectionChanged"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="18,0,0,18">
            <TextBlock x:Name="VersionTextBlock"
                       Foreground="#8A8F98"
                       FontSize="12"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="NewVersionTextBlock"
                       Text=""
                       Foreground="#3AA0FF"
                       FontSize="12"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Cursor="Hand"
                       Visibility="Collapsed"
                       MouseLeftButtonDown="NewVersionTextBlock_Click">
                <TextBlock.Resources>
                    <Storyboard x:Key="BlinkStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="1.0" To="0.3" Duration="0:0:0.8"/>
                    </Storyboard>
                </TextBlock.Resources>
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,0,18,18">
            <Button x:Name="CloseButton"
                    Content=""
                    Width="120"
                    Margin="8,0,0,0"
                    Click="CloseButton_Click"
                    Background="#3A3F4B"
                    Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>

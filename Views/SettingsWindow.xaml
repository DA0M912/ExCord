<Window x:Class="ExCord.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="440"
        Height="820"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#20232A">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Foreground" Value="#AAB0BC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="#20232A"
                                BorderBrush="#3A3F4B"
                                BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2B2F36"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid ClipToBounds="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Background="Transparent"/>
                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter ContentSource="SelectedContent" Margin="12"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="18">
            <TabControl Background="#20232A" BorderBrush="#3A3F4B" BorderThickness="1">
                <TabItem x:Name="GeneralTabItem" Header="" Background="#20232A" Foreground="White">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock x:Name="ApplicationSectionTextBlock" Text="" FontWeight="Bold" Margin="0,0,0,8" Foreground="White"/>
                        <ToggleButton x:Name="AutoStartToggleButton"
                                      Content=""
                                      HorizontalAlignment="Left"
                                      Margin="0,0,0,20"/>
                        <TextBlock x:Name="FeaturesSectionTextBlock" Text="" FontWeight="Bold" Margin="0,0,0,8" Foreground="White"/>
                        <ToggleButton x:Name="TtsToggleButton"
                                      Content=""
                                      HorizontalAlignment="Left"
                                      Margin="0,0,0,10"
                                      Checked="TtsToggleButton_Checked"
                                      Unchecked="TtsToggleButton_Unchecked"/>
                        <ToggleButton x:Name="GifTalkToggleButton"
                                      Content=""
                                      HorizontalAlignment="Left"
                                      Margin="0,0,0,20"
                                      Checked="GifTalkToggleButton_Checked"
                                      Unchecked="GifTalkToggleButton_Unchecked"/>
                        <TextBlock x:Name="LanguageSectionTextBlock"
                                   Text=""
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"
                                   Foreground="White"
                                   Visibility="Collapsed"/>
                        <ComboBox x:Name="LanguageComboBox"
                                  Width="180"
                                  HorizontalAlignment="Left"
                                  Background="#2B2F36"
                                  Foreground="White"
                                  Cursor="Hand"
                                  IsEnabled="False"
                                  Visibility="Collapsed"
                                  SelectionChanged="LanguageComboBox_SelectionChanged"/>
                    </StackPanel>
                </TabItem>

                <TabItem x:Name="TtsTabItem" Header="" Background="#20232A" Foreground="White">
                    <Border x:Name="TtsContentPanel"
                            Margin="0,12,0,0"
                            Padding="0"
                            Background="Transparent"
                            SnapsToDevicePixels="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="0" Opacity="0" Color="Black"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=TtsToggleButton}" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                        <Setter Property="Background" Value="#121212"/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect ShadowDepth="0" BlurRadius="2" Opacity="0.45" Color="Black"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid TextElement.Foreground="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="GlobalHotkeyTextBlock" Grid.Row="0" Text="" FontWeight="Bold" Margin="0,0,0,8" Foreground="White"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                                <CheckBox x:Name="CtrlCheckBox" Content="Ctrl" Margin="0,0,8,0" Foreground="White"/>
                                <CheckBox x:Name="AltCheckBox" Content="Alt" Margin="0,0,8,0" Foreground="White"/>
                                <CheckBox x:Name="ShiftCheckBox" Content="Shift" Margin="0,0,8,0" Foreground="White"/>
                                <ComboBox x:Name="KeyComboBox" Width="120" Background="#2B2F36" Foreground="White" Cursor="Hand">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Foreground" Value="White"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </StackPanel>

                            <TextBlock x:Name="TtsVoiceTextBlock" Grid.Row="2" Text="" FontWeight="Bold" Margin="0,0,0,8" Foreground="White"/>
                            <ComboBox x:Name="VoiceComboBox" Grid.Row="3" Margin="0,0,0,16" DisplayMemberPath="DisplayName" Background="#2B2F36" Foreground="White" Cursor="Hand">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>

                            <TextBlock x:Name="VirtualOutputDeviceTextBlock" Grid.Row="4" Text="" FontWeight="Bold" Margin="0,0,0,8" Foreground="White"/>
                            <ComboBox x:Name="DeviceComboBox" Grid.Row="5" Margin="0,0,0,16" Background="#2B2F36" Foreground="White" Cursor="Hand">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>

                            <TextBlock x:Name="OutputVolumeTextBlock" Grid.Row="6" Text="" FontWeight="Bold" Margin="0,0,0,8" Foreground="White"/>
                            <StackPanel Grid.Row="7" Margin="0,0,0,16">
                                <Slider x:Name="OutputVolumeSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"/>
                                <TextBlock x:Name="OutputVolumeLabel" Text="100%" Margin="0,4,0,0" Foreground="White"/>
                            </StackPanel>

                            <StackPanel Grid.Row="8" Margin="0,0,0,12">
                                <CheckBox x:Name="MonitorEnabledCheckBox" Content="" Margin="0,0,0,8" Foreground="White"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem x:Name="GifTalkTabItem" Header="" Background="#20232A" Foreground="White">
                    <StackPanel Margin="0,12,0,0">
                        <Border x:Name="GifTalkContentPanel"
                                Margin="0"
                                Padding="0"
                                Background="Transparent"
                                SnapsToDevicePixels="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect ShadowDepth="0" BlurRadius="0" Opacity="0" Color="Black"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=GifTalkToggleButton}" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                            <Setter Property="Background" Value="#121212"/>
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect ShadowDepth="0" BlurRadius="2" Opacity="0.45" Color="Black"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel>
                                <TextBlock x:Name="GifUrlTextBlock" Text="" FontWeight="Bold" Margin="0,0,0,8" Foreground="White"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBox x:Name="GifTalkUrlTextBox" Width="260" Background="#2B2F36" Foreground="White"/>
                                    <Button x:Name="ApplyGifTalkUrlButton" Content="" Width="70" Margin="8,0,0,0" Click="ApplyGifTalkUrlButton_Click" Background="#3A3F4B" Foreground="White"/>
                                </StackPanel>

                                <ToggleButton x:Name="GifTalkEditModeToggleButton"
                                              Content=""
                                              Width="120"
                                              HorizontalAlignment="Left"
                                              Margin="0,0,0,16"
                                              Checked="GifTalkEditModeToggleButton_Checked"
                                              Unchecked="GifTalkEditModeToggleButton_Unchecked"
                                              Foreground="White"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="GifTalkXTextBlock" Grid.Row="0" Grid.Column="0" Text="" Margin="0,0,8,8" VerticalAlignment="Center" Foreground="White"/>
                                    <TextBox x:Name="GifTalkXTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,12,8" TextChanged="GifTalkPositionTextBox_TextChanged" Background="#2B2F36" Foreground="White"/>
                                    <TextBlock x:Name="GifTalkYTextBlock" Grid.Row="0" Grid.Column="2" Text="" Margin="0,0,8,8" VerticalAlignment="Center" Foreground="White"/>
                                    <TextBox x:Name="GifTalkYTextBox" Grid.Row="0" Grid.Column="3" Margin="0,0,0,8" TextChanged="GifTalkPositionTextBox_TextChanged" Background="#2B2F36" Foreground="White"/>

                                    <TextBlock x:Name="GifTalkWidthTextBlock" Grid.Row="1" Grid.Column="0" Text="" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White"/>
                                    <TextBox x:Name="GifTalkWidthTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,12,0" TextChanged="GifTalkPositionTextBox_TextChanged" Background="#2B2F36" Foreground="White"/>
                                    <TextBlock x:Name="GifTalkHeightTextBlock" Grid.Row="1" Grid.Column="2" Text="" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White"/>
                                    <TextBox x:Name="GifTalkHeightTextBox" Grid.Row="1" Grid.Column="3" Margin="0,0,0,0" TextChanged="GifTalkPositionTextBox_TextChanged" Background="#2B2F36" Foreground="White"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="18,0,0,18">
            <TextBlock x:Name="VersionTextBlock"
                       Foreground="#8A8F98"
                       FontSize="12"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="NewVersionTextBlock"
                       Text=""
                       Foreground="#3AA0FF"
                       FontSize="12"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Cursor="Hand"
                       Visibility="Collapsed"
                       MouseLeftButtonDown="NewVersionTextBlock_Click">
                <TextBlock.Resources>
                    <Storyboard x:Key="BlinkStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="1.0" To="0.3" Duration="0:0:0.8"/>
                    </Storyboard>
                </TextBlock.Resources>
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,0,18,18">
            <Button x:Name="CloseButton"
                    Content=""
                    Width="120"
                    Margin="8,0,0,0"
                    Click="CloseButton_Click"
                    Background="#3A3F4B"
                    Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
